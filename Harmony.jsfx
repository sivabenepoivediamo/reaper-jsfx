function lib_name(i, dest) (
  i==0 ? strcpy(dest,"Ionian (Major)");
  i==1 ? strcpy(dest,"Dorian");
  i==2 ? strcpy(dest,"Phrygian");
  i==3 ? strcpy(dest,"Lydian");
  i==4 ? strcpy(dest,"Mixolydian");
  i==5 ? strcpy(dest,"Aeolian (Natural Minor)");
  i==6 ? strcpy(dest,"Locrian");
  i==7 ? strcpy(dest,"Melodic Minor");
  i==8 ? strcpy(dest,"Dorian b2");
  i==9 ? strcpy(dest,"Lydian Augmented");
  i==10 ? strcpy(dest,"Lydian Dominant");
  i==11 ? strcpy(dest,"Melodic Major");
  i==12 ? strcpy(dest,"Half Diminished");
  i==13 ? strcpy(dest,"Altered Dominant");
  i==14 ? strcpy(dest,"Harmonic Minor");
  i==15 ? strcpy(dest,"Locrian #6");
  i==16 ? strcpy(dest,"Ionian Augmented");
  i==17 ? strcpy(dest,"Romanian Minor");
  i==18 ? strcpy(dest,"Phrygian Dominant");
  i==19 ? strcpy(dest,"Lydian #2");
  i==20 ? strcpy(dest,"Ultralocrian");
  i==21 ? strcpy(dest,"Adonai Malakh");
  i==22 ? strcpy(dest,"Enigmatic (asc)");
  i==23 ? strcpy(dest,"Enigmatic (desc)");
  i==24 ? strcpy(dest,"Enigmatic Minor");
  i==25 ? strcpy(dest,"Enigmatic Mixed");
  i==26 ? strcpy(dest,"Flamenco");
  i==27 ? strcpy(dest,"Gypsy");
  i==28 ? strcpy(dest,"Gypsy Hexatonic");
  i==29 ? strcpy(dest,"Gypsy Inverse");
  i==30 ? strcpy(dest,"Gypsy Minor");
  i==31 ? strcpy(dest,"Hijaz Major");
  i==32 ? strcpy(dest,"Houseini");
  i==33 ? strcpy(dest,"Houzam");
  i==34 ? strcpy(dest,"Hungarian Major");
  i==35 ? strcpy(dest,"Hungarian Major Inverse");
  i==36 ? strcpy(dest,"Hungarian Minor b2");
  i==37 ? strcpy(dest,"Istrian");
  i==38 ? strcpy(dest,"Jeths");
  i==39 ? strcpy(dest,"Kiourdi");
  i==40 ? strcpy(dest,"Magen Abot");
  i==41 ? strcpy(dest,"Moorish Phrygian");
  i==42 ? strcpy(dest,"Neapolitan Major");
  i==43 ? strcpy(dest,"Neapolitan Major b4");
  i==44 ? strcpy(dest,"Neapolitan Major b5");
  i==45 ? strcpy(dest,"Neapolitan Minor");
