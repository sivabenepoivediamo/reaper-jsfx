// ---------------- basic helpers ----------------
function pmod(x, m) ( x - m*floor(x/m); );
function bitv(m, b) ( floor(m / (2^b)) & 1; );
function copy_arr(dst, src, n) local(i) ( i = 0; loop(n, dst[i] = src[i]; i += 1;); );
function sort_asc(p, n) local(i, j, v) (
  i = 1;
  loop(n - 1,
    v = p[i]; j = i - 1;
    while (j >= 0 && p[j] > v) ( p[j+1] = p[j]; j -= 1; );
    p[j+1] = v;
    i += 1;
  );
);
// PositionVector range: span rounded up to a whole number of `m` cycles
function calc_range(p, n, m) local(i, mx, mn) (
  n <= 0 ? m : (
    mx = p[0]; mn = p[0]; i = 1;
    loop(n - 1, p[i] > mx ? ( mx = p[i]; ); p[i] < mn ? ( mn = p[i]; ); i += 1;);
    m * (floor((mx - mn) / m) + 1);
  );
);
// PositionVector.element(idx)
function pv_el(p, n, r, idx) local(q) (
  n <= 0 ? 0 : ( q = floor(idx / n); p[idx - q*n] + abs(r)*q; );
);
function pos_to_iv(p, n, iv) local(i, R) (
  R = calc_range(p, n, 12);
  i = 0;
  loop(n, iv[i] = pv_el(p, n, R, i + 1) - pv_el(p, n, R, i); i += 1;);
);
function iv_to_pos(start, iv, n, out) local(i, c) (
  c = start; out[0] = c; i = 0;
  loop(n - 1, c += iv[i]; i += 1; out[i] = c;);
);
function pos_mode(p, n, k) local(i) (
  n >= 2 ? (
    pos_to_iv(p, n, A_TIV);
    i = 0; loop(n, A_TIV2[i] = A_TIV[pmod(k + i, n)]; i += 1;);
    iv_to_pos(p[0], A_TIV2, n, A_TMP);
    copy_arr(p, A_TMP, n);
  );
);
function pos_degree(p, n, d) local(i, R) (
  R = calc_range(p, n, 12);
  i = 0; loop(n, A_TMP[i] = pv_el(p, n, R, d + i); i += 1;);
  copy_arr(p, A_TMP, n);
);
// IntervalVector.inversion applied to a scale's intervals
function pos_invert_iv(p, n, ax) local(i, na, len, t) (
  n >= 2 ? (
    pos_to_iv(p, n, A_TIV);
    na = pmod(ax, n + 1);
    i = 0; loop(floor(na / 2), t = A_TIV[i]; A_TIV[i] = A_TIV[na-1-i]; A_TIV[na-1-i] = t; i += 1;);
    len = n - na;
    i = 0; loop(floor(len / 2), t = A_TIV[na+i]; A_TIV[na+i] = A_TIV[n-1-i]; A_TIV[n-1-i] = t; i += 1;);
    iv_to_pos(p[0], A_TIV, n, A_TMP);
    copy_arr(p, A_TMP, n);
  );
);
// PositionVector.inversion(axisIndex, sort=true)
function pos_invert_pv(p, n, ax) local(i, av) (
  n >= 1 ? (
    av = p[pmod(ax, n)];
    i = 0; loop(n, p[i] = 2*av - p[i]; i += 1;);
    sort_asc(p, n);
  );
);
function pos_mirror(p, n) local(i, s0, sl) (
  n >= 1 ? (
    sort_asc(p, n);
    s0 = p[0]; sl = p[n-1];
    i = 0; loop(n, A_TMP[i] = s0 + sl - p[n-1-i]; i += 1;);
    copy_arr(p, A_TMP, n);
  );
);
function pos_negative(p, n, root) local(i, axis, pc) (
  axis = pmod(root*2 + 7, 12);   // 7 = best fifth step in 12-EDO
  i = 0; loop(n, pc = pmod(p[i], 12); p[i] = p[i] - pc + pmod(axis - pc, 12); i += 1;);
  sort_asc(p, n);
);

// ---------------- scale sources ----------------
function mask_to_pos(m, out) local(b, n, f) (
  f = -1; b = 0;
  loop(12, (f < 0 && bitv(m, b)) ? ( f = b; ); b += 1;);
  n = 0; b = 0;
  loop(12, bitv(m, b) ? ( out[n] = b - f; n += 1; ); b += 1;);
  n;
);
// iterative Euclidean (Bjorklund-style) interval generator for 12 steps
function gen_euclid(ev, out) local(n, k, q, r, L, l, i, j, src, dst, slen, dlen, done, t) (
  n = 12; k = ev; L = 0; done = 0;
  while (done == 0) (
    q = floor(n / k); r = n - q*k;
    A_ELQ[L] = q; A_ELR[L] = r; A_ELK[L] = k;
    r == 0 ? ( done = 1; ) : ( n = k; k = r; L += 1; );
  );
  src = A_EB1; dst = A_EB2;
  slen = A_ELK[L]; i = 0; loop(slen, src[i] = A_ELQ[L]; i += 1;);
  l = L - 1;
  while (l >= 0) (
    q = A_ELQ[l]; r = A_ELR[l];
    dlen = 0; i = 0;
    loop(r,
      j = 0; loop(src[i] - 1, dst[dlen] = q; dlen += 1; j += 1;);
      dst[dlen] = q + 1; dlen += 1;
      i += 1;
    );
    t = src; src = dst; dst = t; slen = dlen;
    l -= 1;
  );
  i = 0; loop(slen, out[i] = src[i]; i += 1;);
  slen;
);
function src_mask() local(m, c, ix, i, p, cnt, ev) (
  m = 0;
  sc_src == 0 ? (
    c = floor(sc_cat + 0.5); ix = floor(sc_idx + 0.5);
    ix > M_CATN[c] - 1 ? ( ix = M_CATN[c] - 1; );
    m = M_LIB[M_CATS[c] + ix];
  ) : sc_src == 1 ? (
    ev = min(12, max(1, floor(gen_ev + 0.5)));
    cnt = gen_euclid(ev, A_TMP);
    p = 0; i = 0;
    loop(cnt, m += 2^p; p += A_TMP[i]; i += 1;);
  ) : sc_src == 2 ? (
    ev = min(12, max(1, floor(gen_ev + 0.5)));
    i = 0;
    loop(ev, p = pmod(floor(i * 12 / ev), 12); bitv(m, p) ? 0 : ( m += 2^p; ); i += 1;);
  ) : sc_src == 3 ? (
    ev = max(1, floor(gen_ev + 0.5));
    i = 0;
    loop(ev, p = pmod(i * floor(gen_mult + 0.5), 12); bitv(m, p) ? 0 : ( m += 2^p; ); i += 1;);
  ) : (
    i = 0;
    loop(scp_n, p = pmod(A_SCP[i], 12); bitv(m, p) ? 0 : ( m += 2^p; ); i += 1;);
  );
  m;
);

// scale transform chain (fixed order: Root, Mode, Degree, Invert, Mirror, Negative)
function build_scale(out, k) local(i, n) (
  n = bn;
  copy_arr(out, A_BP, n);
  i = 0; loop(n, out[i] += tx_root; i += 1;);
  (n >= 2 && k != 0) ? ( pos_mode(out, n, k); );
  tx_deg != 0 ? ( pos_degree(out, n, tx_deg); );
  tx_inv ? ( pos_invert_iv(out, n, tx_inv_ax); );
  tx_mir ? ( pos_mirror(out, n); );
  tx_neg ? ( pos_negative(out, n, tx_root); );
);

// ---------------- chord ops ----------------
function op_close(p, n) local(i, j, oct, found, m, bestOct, bestCnt, n2, mapped, dup) (
  m = 0; i = 0;
  loop(n,
    oct = floor(p[i] / 12) * 12;
    found = -1; j = 0;
    loop(m, A_TIV[j] == oct ? ( found = j; ); j += 1;);
    found >= 0 ? ( A_TIV2[found] += 1; ) : ( A_TIV[m] = oct; A_TIV2[m] = 1; m += 1; );
    i += 1;
  );
  bestOct = A_TIV[0]; bestCnt = A_TIV2[0]; j = 1;
  loop(m - 1,
    (A_TIV2[j] > bestCnt || (A_TIV2[j] == bestCnt && A_TIV[j] < bestOct)) ? ( bestCnt = A_TIV2[j]; bestOct = A_TIV[j]; );
    j += 1;
  );
  n2 = 0; i = 0;
  loop(n,
    mapped = bestOct + pmod(p[i], 12);
    dup = 0; j = 0;
    loop(n2, A_TMP[j] == mapped ? ( dup = 1; ); j += 1;);
    dup ? 0 : ( A_TMP[n2] = mapped; n2 += 1; );
    i += 1;
  );
  sort_asc(A_TMP, n2);
  copy_arr(p, A_TMP, n2);
  n2;
);
function op_resize(p, n) local(i, R, cnt, s, e) (
  sort_asc(p, n);
  R = calc_range(p, n, 12);
  s = cx_rs0; e = cx_rs1; cnt = 0;
  s <= e ? (
    i = s; loop(e - s + 1, A_TMP[cnt] = pv_el(p, n, R, i); cnt += 1; i += 1;);
  ) : (
    i = s; loop(s - e + 1, A_TMP[cnt] = pv_el(p, n, R, i); cnt += 1; i -= 1;);
  );
  copy_arr(p, A_TMP, cnt);
  cnt;
);
// spread: iterative backtracking search (EEL2 has no recursion)
function spread_build(d, n, strict, minLow, minHigh) local(mi, prev, lo, hi, i, cnt, c, off, j, base) (
  mi = n > 2 ? floor(minLow + (minHigh - minLow) * d / (n - 2) + 0.5) : minLow;
  prev = SP_RES[d]; lo = prev + mi + 1; hi = prev + 11;
  cnt = 0; i = 0; base = d * 16;
  loop(n - 1,
    bitv(SP_USED[d], i) == 0 ? (
      off = pmod(SP_PC[i] - pmod(lo, 12), 12);
      c = lo + off;
      (strict == 0 || c <= hi) ? (
        j = cnt;
        while (j > 0 && SP_CAND[base + j - 1] > c) (
          SP_CAND[base + j] = SP_CAND[base + j - 1]; SP_IDX[base + j] = SP_IDX[base + j - 1]; j -= 1;
        );
        SP_CAND[base + j] = c; SP_IDX[base + j] = i; cnt += 1;
      );
    );
    i += 1;
  );
  SP_CNT[d] = cnt;
);
function spread_dfs(n, strict, minLow, minHigh) local(d, nodes, found, j) (
  d = 0; nodes = 0; found = 0;
  SP_USED[0] = 0;
  spread_build(0, n, strict, minLow, minHigh); SP_PTR[0] = 0;
  while (d >= 0 && found == 0 && nodes < 20000) (
    SP_PTR[d] >= SP_CNT[d] ? ( d -= 1; ) : (
      j = SP_PTR[d]; SP_PTR[d] += 1; nodes += 1;
      SP_RES[d + 1] = SP_CAND[d * 16 + j];
      (d + 1 == n - 1) ? ( found = 1; ) : (
        SP_USED[d + 1] = SP_USED[d] + 2^SP_IDX[d * 16 + j];
        d += 1;
        spread_build(d, n, strict, minLow, minHigh); SP_PTR[d] = 0;
      );
    );
  );
  found;
);
function op_spread(p, n) local(i, minLow, minHigh, ok) (
  (n > 1 && n <= 16) ? (
    copy_arr(A_TMP, p, n); sort_asc(A_TMP, n);
    minLow = 2;                          // round(log2(9/8) * 12)
    minHigh = cx_topcl ? 0 : 5;          // round(log2(4/3) * 12)
    SP_RES[0] = A_TMP[0];
    i = 1; loop(n - 1, SP_PC[i - 1] = pmod(A_TMP[i], 12); i += 1;);
    ok = spread_dfs(n, 1, minLow, minHigh);
    ok == 0 ? ( ok = spread_dfs(n, 0, minLow, minHigh); );
    ok ? ( copy_arr(p, SP_RES, n); );
  );
);
// voice leading (complexity 0 = closest voicing to the previous chord)
function var_dist(a, na, b, nb) local(i, j, minLen, maxLen, tot, x, mn, mx, d, lp, sp, sl) (
  copy_arr(A_TIV, a, na); sort_asc(A_TIV, na);
  copy_arr(A_TIV2, b, nb); sort_asc(A_TIV2, nb);
  minLen = min(na, nb); maxLen = max(na, nb);
  tot = 0; i = 0;
  loop(minLen, tot += abs(A_TIV[i] - A_TIV2[i]); i += 1;);
  na >= nb ? ( lp = A_TIV; sp = A_TIV2; sl = nb; ) : ( lp = A_TIV2; sp = A_TIV; sl = na; );
  i = minLen;
  loop(maxLen - minLen,
    x = lp[i]; mn = 1000000000000000; mx = -1000000000000000; j = 0;
    loop(sl, d = abs(x - sp[j]); d < mn ? ( mn = d; ); d > mx ? ( mx = d; ); j += 1;);
    tot += (mn + mx) / 2;
    i += 1;
  );
  tot;
);
function op_voice_leading(p, n) local(Rr, Rt, minV, i, g, center, c, j, d, bestD, bestI) (
  n > 0 ? (
    (vl_n > 0) ? (
      Rr = calc_range(A_VL, vl_n, 12); Rt = calc_range(p, n, 12);
      minV = A_VL[0];
      i = (floor(A_VL[0] / Rr) - floor(p[0] / Rt)) * n;
      g = 0; while (pv_el(p, n, Rt, i) <= minV && g < 2000) ( i += 1; g += 1; );
      g = 0; while (pv_el(p, n, Rt, i) > minV && g < 2000) ( i -= 1; g += 1; );
      center = i; bestD = 1000000000000000; bestI = center; c = center - n;
      loop(2 * n + 1,
        j = 0; loop(n, A_TMP2[j] = pv_el(p, n, Rt, c + j); j += 1;);
        d = var_dist(A_VL, vl_n, A_TMP2, n);
        d < bestD ? ( bestD = d; bestI = c; );
        c += 1;
      );
      j = 0; loop(n, A_TMP2[j] = pv_el(p, n, Rt, bestI + j); j += 1;);
      copy_arr(p, A_TMP2, n);
    );
    copy_arr(A_VL, p, n); vl_n = n;
  );
);

// ---------------- slider writes that don't count as user edits ----------------
function set_sl(idx, v) ( slider(idx) = v; SH[idx] = v; sliderchange(2^(idx - 1)); );
function set_shift(v) local(c) ( c = max(DEG_MIN, min(DEG_MAX, v)); set_sl(S_SHIFT, c); );

// ---------------- chord builder ----------------
// returns number of chord tones written to A_CH (step space)
function chord_select() local(N, es, s, sR, nc, i, v, rot, outLen, cr, k, cum, ns, r, q) (
  N = sc_n; s = ch_shift; v = floor(ch_voices + 0.5); rot = ch_rot;
  cx_neg ? (
    copy_arr(A_EFF, A_SC, N); pos_negative(A_EFF, N, tx_root);
    es = A_EFF;
    q = s / N; q = q >= 0 ? floor(q) : ceil(q);
    r = s - N * q;
    s = s - 2 * r;                       // foldDegree
  ) : ( es = A_SC; );
  sR = calc_range(es, N, 12);
  cr_type == 0 ? (
    nc = 0; i = 0;
    loop(crp_n, A_CRP[i] >= 0 ? ( A_CRIT[nc] = A_CRP[i]; nc += 1; ); i += 1;);
    nc == 0 ? ( 0; ) : (
      sort_asc(A_CRIT, nc);
      i = 0; loop(nc, A_CRIT[i] += s; i += 1;);
      cr = calc_range(A_CRIT, nc, N);
      outLen = v > 0 ? v : nc;
      k = 0; loop(outLen, A_CH[k] = pv_el(es, N, sR, pv_el(A_CRIT, nc, cr, rot + k)); k += 1;);
      outLen;
    );
  ) : (
    ns = cri_n;
    ns <= 0 ? ( 0; ) : (
      outLen = v > 0 ? v : ns;
      cum = s; k = 0;
      loop(outLen, A_CH[k] = pv_el(es, N, sR, cum); cum += A_CRI[pmod(rot + k, ns)]; k += 1;);
      outLen;
    );
  );
);
function chord_transforms(n) local(i) (
  pos_degree(A_CH, n, cx_pos);
  cx_off != 0 ? ( i = 0; loop(n, A_CH[i] += cx_off; i += 1;); );
  (cx_mode != 0 && n >= 2) ? ( pos_mode(A_CH, n, cx_mode); );
  cx_inv ? ( pos_invert_pv(A_CH, n, cx_inv_ax); );
  cx_mir ? ( pos_mirror(A_CH, n); );
  cx_close ? ( n = op_close(A_CH, n); );
  cx_spread ? ( op_spread(A_CH, n); );
  cx_resize ? ( n = op_resize(A_CH, n); );
  cx_vl ? ( op_voice_leading(A_CH, n); );
  n;
);
function chord_finalize(n) local(i, note, j, dup) (
  cm_n = 0; i = 0;
  loop(n,
    note = A_CH[i] + floor(ch_oct + 0.5) * 12 + 12 + root_oct_off;   // step space (C0 = 0) -> MIDI
    (note >= 0 && note <= 127) ? (
      dup = 0; j = 0;
      loop(cm_n, A_CHM[j] == note ? ( dup = 1; ); j += 1;);
      dup ? 0 : ( A_CHM[cm_n] = note; cm_n += 1; );
    );
    i += 1;
  );
);
function rebuild_chord() local(n) (
  ch_cnt = 0; cm_n = 0;
  sc_n > 0 ? (
    n = chord_select();
    n > 0 ? ( n = chord_transforms(n); ch_cnt = n; chord_finalize(n); );
  );
);
function rebuild_scale() local(m, i, c) (
  m = src_mask();
  bn = mask_to_pos(m, A_BP);
  bn <= 0 ? ( sc_n = 0; ch_cnt = 0; cm_n = 0; ) : (
    sc_n = bn;
    build_scale(A_SC, tx_mode);
    copy_arr(A_PRE, A_SC, sc_n);
    auto_mod_t >= 0 ? (
      i = 0; loop(sc_n, A_SC[i] = pmod(A_SC[i] + auto_mod_t, 12); i += 1;);
      sort_asc(A_SC, sc_n);
    );
    build_scale(A_BASE, auto_base_rot);
    sc_n != last_N ? (
      last_N = sc_n;
      c = max(DEG_MIN, min(DEG_MAX, ch_shift));
      c != ch_shift ? ( set_sl(S_SHIFT, c); );
    );
    rebuild_chord();
  );
  // pitch-class mask of the live scale (for display)
  scale_pcm = 0; i = 0;
  loop(sc_n, c = pmod(A_SC[i], 12); bitv(scale_pcm, c) ? 0 : ( scale_pcm += 2^c; ); i += 1;);
  name_dirty = 1;
);


// ---------------- output: polyphonic voices with shared-note ownership ----------------
// Every held input key owns a voice: the chord computed when that key was pressed.
// O_REF counts how many voices currently own each (channel, note):
//  - a note-on is sent only when the count goes 0 -> 1, so a note two chords have in
//    common is held (legato), not re-triggered, unless Common Notes = Retrigger;
//  - a note-off is sent only when the count returns to 0, so releasing one key never
//    cuts a note that another held key's chord still uses.
function out_on(offs, note, vel, och) local(ix) (
  ix = och * 128 + note;
  O_REF[ix] <= 0 ? (
    midisend(offs, 0x90 + och, note, vel);
  ) : common_mode == 1 ? (
    midisend(offs, 0x80 + och, note, 0);
    midisend(offs, 0x90 + och, note, vel);
  );
  O_REF[ix] += 1;
);
function out_off(offs, note, och) local(ix) (
  ix = och * 128 + note;
  O_REF[ix] > 0 ? (
    O_REF[ix] -= 1;
    O_REF[ix] <= 0 ? ( midisend(offs, 0x80 + och, note, 0); );
  );
);
function voice_off(offs, key) local(i, b, och) (
  V_ACT[key] ? (
    b = V_NOTES + key * 64; och = V_CH[key];
    i = 0; loop(V_CNT[key], out_off(offs, b[i], och); i += 1;);
    V_ACT[key] = 0; V_CNT[key] = 0;
  );
);
// direct = 1: the voice is just the key itself (pass-through); otherwise the current chord
function voice_on(offs, key, vel, ch, direct) local(i, b, n, och) (
  voice_off(offs, key);
  och = out_ch == 0 ? ch : out_ch - 1;
  b = V_NOTES + key * 64;
  direct ? ( b[0] = key; n = 1; ) : (
    n = min(cm_n, 64); i = 0; loop(n, b[i] = A_CHM[i]; i += 1;);
  );
  V_ACT[key] = 1; V_CNT[key] = n; V_CH[key] = och;
  i = 0; loop(n, out_on(offs, b[i], vel, och); i += 1;);
);
function all_off(offs) local(ix, k) (
  ix = 0;
  loop(2048,
    O_REF[ix] > 0 ? ( k = floor(ix / 128); midisend(offs, 0x80 + k, ix - k * 128, 0); );
    O_REF[ix] = 0; ix += 1;
  );
  ix = 0; loop(128, V_ACT[ix] = 0; V_CNT[ix] = 0; ix += 1;);
);

// ---------------- held-key stack (all held input notes, oldest -> newest) ----------------
function stk_find(id) local(i, r) ( r = -1; i = 0; loop(stk_n, A_STK[i] == id ? ( r = i; ); i += 1;); r; );
function stk_press(id, vel, ch) local(f) (
  f = stk_find(id);
  f >= 0 ? ( 0; ) : ( A_STK[stk_n] = id; A_STKV[stk_n] = vel; A_STKC[stk_n] = ch; stk_n += 1; 1; );
);
function stk_release(id) local(f, wasTop, i) (
  f = stk_find(id);
  f < 0 ? ( 0; ) : (
    wasTop = (f == stk_n - 1);
    i = f; loop(stk_n - 1 - f, A_STK[i] = A_STK[i+1]; A_STKV[i] = A_STKV[i+1]; A_STKC[i] = A_STKC[i+1]; i += 1;);
    stk_n -= 1;
    wasTop;
  );
);
function white_degree(note) local(anchor, oct, pc, pos) (
  pc = pmod(note, 12);
  pos = pc == 0 ? 0 : pc == 2 ? 1 : pc == 4 ? 2 : pc == 5 ? 3 : pc == 7 ? 4 : pc == 9 ? 5 : pc == 11 ? 6 : -1;
  pos < 0 ? ( NONE; ) : (
    anchor = 60 + (floor(ch_oct + 0.5) - 4) * 12;   // degree 0 = the key whose pitch equals the chord's root
    floor((note - anchor) / 12) * 7 + pos;
  );
);

// ---------------- Auto mode ----------------
function contains_notes(p, n) local(i, j, pc, ok, hit) (
  ok = 1; i = 0;
  loop(stk_n,
    pc = pmod(A_STK[i], 12); hit = 0; j = 0;
    loop(n, pmod(p[j], 12) == pc ? ( hit = 1; ); j += 1;);
    hit ? 0 : ( ok = 0; );
    i += 1;
  );
  ok;
);
function manhattan(a, b, n) local(i, s) ( s = 0; i = 0; loop(n, s += abs(a[i] - b[i]); i += 1;); s; );
function step_to_degree(p, n, step) local(i, R, diff, bestI, bestD, d, found, res) (
  R = calc_range(p, n, 12);
  bestI = 0; bestD = 1000000000000000; found = 0; res = 0; i = 0;
  loop(n,
    found == 0 ? (
      diff = step - p[i];
      pmod(diff, R) == 0 ? ( found = 1; res = i + (diff / R) * n; ) : (
        d = min(pmod(step - p[i], 12), pmod(p[i] - step, 12));
        d < bestD ? ( bestD = d; bestI = i; );
      );
    );
    i += 1;
  );
  found ? res : bestI;
);
function ic_pick(ref) local(i, j, bi, bd, d, n) (
  n = sc_n; bi = -1; bd = 1000000000000000;
  pos_to_iv(A_BASE, n, A_TIV);
  i = 0;
  loop(n,
    j = 0; loop(n, A_TIV2[j] = A_TIV[pmod(i + j, n)]; j += 1;);
    iv_to_pos(A_BASE[0], A_TIV2, n, A_TMP2);
    contains_notes(A_TMP2, n) ? (
      d = manhattan(ref, A_TMP2, n);
      d < bd ? ( bd = d; bi = i; );
    );
    i += 1;
  );
  bi;
);
function mod_pick(ref) local(i, j, bi, bd, d, n) (
  n = sc_n; bi = -1; bd = 1000000000000000;
  i = 0;
  loop(12,
    j = 0; loop(n, A_TMP2[j] = pmod(A_PRE[j] + i, 12); j += 1;);
    sort_asc(A_TMP2, n);
    contains_notes(A_TMP2, n) ? (
      d = manhattan(ref, A_TMP2, n);
      d < bd ? ( bd = d; bi = i; );
    );
    i += 1;
  );
  bi;
);
// The baseline (initial selected scale) is shared by both sub-modes: mode rotation + degree.
// Modulation transposition (auto_mod_t) is always relative to it.
function auto_enter() (
  auto_base_shift = ch_shift;
  auto_base_rot = tx_mode;
  auto_mod_t = -1;
  need_rebuild = 1;
);
// back to the baseline without touching the baseline itself (rebuild happens later)
function auto_restore() (
  auto_mod_t = -1;
  set_sl(S_MODE, auto_base_rot);
  set_shift(auto_base_shift);
  need_rebuild = 1;
);
function auto_do_reset(offs) (
  all_off(offs);
  auto_mod_t = -1;
  set_sl(S_MODE, auto_base_rot); rebuild_scale();
  set_shift(auto_base_shift); rebuild_chord();
);
function auto_changed(offs) local(top, vel, ch, p, ref, bi, step, deg) (
  top = A_STK[stk_n - 1]; vel = A_STKV[stk_n - 1]; ch = A_STKC[stk_n - 1];
  (auto_rst && stk_n == 1) ? (
    auto_mod_t = -1;
    set_sl(S_MODE, auto_base_rot); rebuild_scale();
    set_shift(auto_base_shift); rebuild_chord();
  );
  contains_notes(A_SC, sc_n) ? 0 : (
    auto_sub == 0 ? (
      sc_n >= 2 ? (
        ref = auto_ref ? A_SC : A_BASE;
        bi = ic_pick(ref);
        bi >= 0 ? ( set_sl(S_MODE, pmod(auto_base_rot + bi, sc_n)); rebuild_scale(); );
      );
    ) : (
      ref = auto_ref ? A_SC : A_PRE;
      bi = mod_pick(ref);
      bi >= 0 ? ( auto_mod_t = bi; rebuild_scale(); );
    );
  );
  step = top - 60;
  deg = step_to_degree(A_SC, sc_n, step);
  set_shift(deg); rebuild_chord();
  voice_on(offs, top, vel, ch, 0);
);

// ---------------- note dispatch (polyphonic) ----------------
// Each held key triggers its own chord. The global parameters (root / degree / scale
// mode) follow the most recently pressed key; chords of other held keys keep sounding.
function trigger(offs, note, vel, ch) (
  in_mode == 2 ? (
    voice_on(offs, note, vel, ch, 1);
  ) : in_mode == 0 ? (
    root_oct_off = (floor(note / 12) - 5) * 12;   // no octave looping: the chord sits in the octave of the key (middle C octave = Chord Octave setting)
    set_sl(S_ROOT, pmod(note, 12)); rebuild_scale();
    voice_on(offs, note, vel, ch, 0);
  ) : in_mode == 1 ? (
    set_shift(white_degree(note)); rebuild_chord();
    voice_on(offs, note, vel, ch, 0);
  ) : (
    auto_changed(offs);      // Auto: considers ALL held notes, then voices this key
  );
);
function do_note_on(offs, note, vel, ch) (
  (in_mode == 1 && white_degree(note) == NONE) ? ( 0; ) : (   // Degree mode: white keys only
    stk_release(note);          // same key struck again while held: restart it
    voice_off(offs, note);
    stk_press(note, vel, ch);
    trigger(offs, note, vel, ch);
  );
);
function do_note_off(offs, note) (
  stk_release(note);
  voice_off(offs, note);
);
function panic(offs) local(i) (
  all_off(offs);
  stk_n = 0;
  i = 0; loop(128, A_NDEG[i] = NONE; i += 1;);
);

// ---------------- parameter change handling ----------------
function handle_changes(offs) local(i, c_mode, c_sub, c_txmode, c_txroot, any) (
  c_mode = in_mode != SH[S_INMODE];
  c_sub = auto_sub != SH[S_SUB];
  c_txmode = tx_mode != SH[S_MODE];
  c_txroot = tx_root != SH[S_ROOT];
  any = (lists_ver != lists_ver_sh); i = 1;
  loop(NSL, slider(i) != SH[i] ? ( any = 1; ); i += 1;);
  need_rebuild = any;

  c_mode ? (
    (prev_mode == 3 && in_mode != 3) ? ( c_txmode ? ( auto_mod_t = -1; need_rebuild = 1; ) : ( auto_restore(); ); );   // leaving Auto: back to the initial scale
    root_oct_off = 0;
    panic(offs);
    in_mode == 3 ? ( auto_enter(); );
    prev_mode = in_mode;
  ) : in_mode == 3 ? (
    c_sub ? (
      c_txmode ? ( auto_enter(); ) : ( auto_restore(); );   // switching sub-mode returns to the initial scale
    ) : (
      (c_txmode && auto_sub == 0) ? ( auto_enter(); );
      (c_txroot && auto_sub == 1) ? ( auto_enter(); );
      (c_txmode && auto_sub == 1) ? ( auto_base_rot = tx_mode; );   // user picked a new mode: it is the new baseline
    );
  );

  need_rebuild ? ( rebuild_scale(); );

  act != 0 ? (
    act == 1 ? ( auto_do_reset(offs); );
    act == 2 ? ( vl_n = 0; );
    set_sl(S_ACT, 0);
  );

  i = 1; loop(NSL, SH[i] = slider(i); i += 1;);
  lists_ver_sh = lists_ver;
);

@block
handle_changes(0);
while (midirecv(offs, m1, m2, m3)) (
  st = m1 & 0xF0; chn = m1 & 15;
  (st == 0x90 && m3 > 0) ? (
    do_note_on(offs, m2, m3, chn);
  ) : (st == 0x80 || (st == 0x90 && m3 == 0)) ? (
    do_note_off(offs, m2);
  ) : (
    (st == 0xB0 && (m2 == 123 || m2 == 120)) ? ( panic(offs); );
    midisend(offs, m1, m2, m3);
  );
);

@serialize
file_var(0, crp_n); file_mem(0, A_CRP, LIST_MAX);
file_var(0, cri_n); file_mem(0, A_CRI, LIST_MAX);
file_var(0, scp_n); file_mem(0, A_SCP, LIST_MAX);
crp_n = max(0, min(LIST_MAX, crp_n)); cri_n = max(0, min(LIST_MAX, cri_n)); scp_n = max(0, min(LIST_MAX, scp_n));
lists_ver += 1;

@gfx 1010 530
// =====================================================================
//  GUI  (design size 1010 x 530, scaled uniformly to fit the window)
// =====================================================================
DW = 1010; DH = 530;
PCNAMES = "C C#D D#E F F#G G#A A#B ";

function hit(x, y, w, h) ( mx >= x && mx < x + w && my >= y && my < y + h; );
function fr(x, y, w, h) ( gfx_rect(ox + x * uis, oy + y * uis, w * uis, h * uis); );
function ft(x, y, s, fi) ( gfx_setfont(fi); gfx_x = ox + x * uis; gfx_y = oy + y * uis; gfx_drawstr(s); );
function ftc(x, y, w, h, s, fi) local(tw, th) (
  gfx_setfont(fi); gfx_measurestr(s, tw, th);
  gfx_x = ox + (x + w / 2) * uis - tw / 2; gfx_y = oy + (y + h / 2) * uis - th / 2; gfx_drawstr(s);
);
function ftr(x, y, w, s, fi) local(tw, th) (   // right aligned, x = left edge of box of width w
  gfx_setfont(fi); gfx_measurestr(s, tw, th);
  gfx_x = ox + (x + w) * uis - tw; gfx_y = oy + y * uis; gfx_drawstr(s);
);
function fit_head(s, maxw, fi) local(tw, th, len) (   // keep the beginning, trim the end
  gfx_setfont(fi); gfx_measurestr(s, tw, th); len = strlen(s);
  while (tw > maxw * uis && len > 1) ( len -= 1; str_setlen(s, len); gfx_measurestr(s, tw, th); );
);
function fit_tail(s, maxw, fi) local(tw, th) (     // keep the end, trim the beginning
  gfx_setfont(fi); gfx_measurestr(s, tw, th);
  while (tw > maxw * uis && strlen(s) > 1) ( str_delsub(s, 0, 1); gfx_measurestr(s, tw, th); );
);
function pcname(pc, dst) ( strcpy_substr(dst, PCNAMES, pc * 2, (pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10) ? 2 : 1); );
function note_name(n, dst) local(pc) (
  pc = pmod(n, 12); pcname(pc, dst);
  sprintf(#nn_oct, "%d", floor(n / 12) - 1); strcat(dst, #nn_oct);
);

// ---------- generic widgets ----------
function btn(x, y, w, h, s, on, fi) local(hov) (
  hov = hit(x, y, w, h);
  on ? gfx_set(0.93, 0.62, 0.28, 1) : ( hov ? gfx_set(0.26, 0.29, 0.35, 1) : gfx_set(0.18, 0.20, 0.25, 1) );
  fr(x, y, w, h);
  on ? gfx_set(0.08, 0.09, 0.11, 1) : gfx_set(0.86, 0.85, 0.82, 1);
  ftc(x, y, w, h, s, fi);
  hov && mclick;
);
function set_sl_ui(si, v) ( slider(si) != v ? ( slider(si) = v; slider_automate(2^(si - 1)); ); );
function tog(x, y, w, h, s, si) ( btn(x, y, w, h, s, slider(si) > 0.5, 1) ? set_sl_ui(si, slider(si) > 0.5 ? 0 : 1); );
function opt(x, y, w, h, s, si, val) ( btn(x, y, w, h, s, slider(si) == val, 1) ? set_sl_ui(si, val); );
// value box with label: click left/right half = -1/+1, drag, wheel, right-click = default
function stepper(x, y, w, lw, label, si, vmin, vmax, fmt, dflt) local(bx, bw, v, nv, hov, id) (
  bx = x + lw; bw = w - lw; v = slider(si); nv = v; id = 100 + si;
  hov = hit(bx, y, bw, 20);
  (hov && wheel != 0) ? ( nv = v + (wheel > 0 ? 1 : -1); wheel = 0; );
  (hov && rclick) ? ( nv = dflt; );
  (hov && mclick) ? ( act_id = id; drag_x0 = mx; drag_v0 = v; drag_moved = 0; );
  act_id == id ? (
    mdown ? (
      abs(mx - drag_x0) > 4 ? ( drag_moved = 1; );
      drag_moved ? ( nv = drag_v0 + floor((mx - drag_x0) / 10); );
    ) : (
      (drag_moved == 0 && hov) ? ( nv = mx < bx + bw / 2 ? v - 1 : v + 1; );
      act_id = 0;
    );
  );
  nv = max(vmin, min(vmax, nv));
  set_sl_ui(si, nv);
  v = slider(si);
  lw > 0 ? ( gfx_set(0.60, 0.62, 0.67, 1); ft(x, y + 3, label, 1); );
  (hov || act_id == id) ? gfx_set(0.27, 0.30, 0.37, 1) : gfx_set(0.18, 0.20, 0.25, 1);
  fr(bx, y, bw, 20);
  gfx_set(0.45, 0.47, 0.52, 1);
  gfx_triangle(ox + (bx + 9) * uis, oy + 6 * uis + y * uis, ox + (bx + 9) * uis, oy + 14 * uis + y * uis, ox + (bx + 4) * uis, oy + 10 * uis + y * uis);
  gfx_triangle(ox + (bx + bw - 9) * uis, oy + 6 * uis + y * uis, ox + (bx + bw - 9) * uis, oy + 14 * uis + y * uis, ox + (bx + bw - 4) * uis, oy + 10 * uis + y * uis);
  fmt == 1 ? ( pcname(pmod(v, 12), #vs); ) :
  fmt == 2 ? ( v == 0 ? strcpy(#vs, "Same") : sprintf(#vs, "%d", v); ) :
             ( sprintf(#vs, "%d", v); );
  gfx_set(0.95, 0.94, 0.90, 1); ftc(bx, y, bw, 20, #vs, 1);
);
function section(x, y, w, h, num, title) (
  gfx_set(0.105, 0.12, 0.145, 1); fr(x, y, w, h);
  gfx_set(0.93, 0.62, 0.28, 1); ft(x + 8, y + 6, title, 1);
  gfx_set(0.40, 0.42, 0.47, 1); ft(x + w - 16, y + 6, num, 1);
);

// ---------- integer-array lists (criteria / custom scale) ----------
function list_ptr(id) ( id == 1 ? A_SCP : ( id == 2 ? A_CRP : A_CRI ); );
function list_len(id) ( id == 1 ? scp_n : ( id == 2 ? crp_n : cri_n ); );
function list_set_len(id, n) ( id == 1 ? ( scp_n = n; ) : ( id == 2 ? ( crp_n = n; ) : ( cri_n = n; ); ); lists_ver += 1; );
function list_str(id, dst) local(p, n, i) (
  p = list_ptr(id); n = list_len(id); strcpy(dst, ""); i = 0;
  loop(n, sprintf(#ls_t, "%d", p[i]); strcat(dst, #ls_t); i < n - 1 ? strcat(dst, ", "); i += 1;);
);
function parse_list(str, dst, nonneg) local(i, len, c, cur, have, neg, n, v) (
  len = strlen(str); n = 0; have = 0; neg = 0; cur = 0; i = 0;
  loop(len + 1,
    c = i < len ? str_getchar(str, i) : 32;
    (c >= 48 && c <= 57) ? ( cur = cur * 10 + (c - 48); have = 1; ) :
    (c == 45 && have == 0) ? ( neg = 1; ) : (
      have ? (
        v = neg ? -cur : cur;
        ((nonneg == 0 || v >= 0) && n < LIST_MAX) ? ( dst[n] = v; n += 1; );
      );
      cur = 0; have = 0; neg = 0;
    );
    i += 1;
  );
  n;
);
// single-line text field. mode 0 = integer list, 1 = free text. returns 1 on commit
function tf_run(id, x, y, w, h, mode) local(res, hov, c, len, ok, k, blink) (
  res = 0; hov = hit(x, y, w, h);
  (mclick && hov && tf_id != id) ? ( tf_id = id; strcpy(#tfbuf, #tfshow); tf_first = 1; );
  tf_id == id ? (
    tf_seen = 1;
    k = 0;
    loop(16,
      c = tf_id == id ? gfx_getchar() : 0;
      c > 0 ? (
        c == 8 ? (
          tf_first ? ( strcpy(#tfbuf, ""); ) : ( len = strlen(#tfbuf); len > 0 ? str_setlen(#tfbuf, len - 1); );
          tf_first = 0;
        ) : c == 13 ? ( res = 1; tf_id = 0; ) : c == 27 ? ( tf_id = 0; ) : (c >= 32 && c < 127) ? (
          ok = mode == 1 ? 1 : ((c >= 48 && c <= 57) || c == 45 || c == 44 || c == 32);
          ok ? (
            tf_first ? ( strcpy(#tfbuf, ""); );
            tf_first = 0;
            sprintf(#tfc, "%c", c); strcat(#tfbuf, #tfc);
          );
        );
      );
    );
    (mclick && !hov && tf_id == id) ? ( res = 1; tf_id = 0; );
  );
  tf_id == id ? ( gfx_set(0.93, 0.62, 0.28, 1); ) : ( gfx_set(0.30, 0.33, 0.40, 1); );
  fr(x - 1, y - 1, w + 2, h + 2);
  gfx_set(0.07, 0.08, 0.10, 1); fr(x, y, w, h);
  tf_id == id ? (
    strcpy(#tfdraw, #tfbuf);
    blink = (floor(time_precise() * 2) & 1);
    blink ? strcat(#tfdraw, "|");
    fit_tail(#tfdraw, w - 10, 1);
    gfx_set(1, 1, 1, 1);
  ) : (
    strcpy(#tfdraw, #tfshow);
    fit_head(#tfdraw, w - 10, 1);
    gfx_set(0.85, 0.85, 0.82, 1);
  );
  ft(x + 5, y + (h - 14) / 2, #tfdraw, 1);
  res;
);
// editable value chips: click +1, right-click -1, shift-click removes, [+] appends
function chips(x, y, id, minv) local(p, n, k, cx, cy, hov, v, j, shown, per, rows) (
  p = list_ptr(id); n = list_len(id); per = 8; rows = 3;
  shown = min(n + 1, per * rows);
  k = 0;
  loop(shown,
    cx = x + (k % per) * 28; cy = y + floor(k / per) * 22;
    hov = hit(cx, cy, 25, 20);
    k < n ? (
      v = p[k];
      hov ? gfx_set(0.30, 0.34, 0.42, 1) : gfx_set(0.20, 0.23, 0.29, 1);
      fr(cx, cy, 25, 20);
      gfx_set(0.95, 0.94, 0.90, 1); sprintf(#ch_s, "%d", v); ftc(cx, cy, 25, 20, #ch_s, 1);
      hov && mclick ? (
        shiftk ? (
          j = k; loop(n - 1 - k, p[j] = p[j + 1]; j += 1;);
          list_set_len(id, n - 1);
        ) : ( p[k] = v + 1; lists_ver += 1; );
      );
      (hov && rclick) ? ( p[k] = max(minv, v - 1); lists_ver += 1; );
    ) : (
      hov ? gfx_set(0.30, 0.34, 0.42, 1) : gfx_set(0.14, 0.16, 0.20, 1);
      fr(cx, cy, 25, 20);
      gfx_set(0.93, 0.62, 0.28, 1); ftc(cx, cy, 25, 20, "+", 1);
      (hov && mclick && n < LIST_MAX) ? (
        p[n] = n > 0 ? p[n - 1] + (id == 2 ? 2 : 0) : (id == 2 ? 0 : 2);
        list_set_len(id, n + 1);
      );
    );
    k += 1;
  );
  n + 1 > per * rows ? ( gfx_set(0.55, 0.57, 0.62, 1); sprintf(#more, "+%d more (edit with the text field)", n + 1 - per * rows); ft(x, y + rows * 22, #more, 3); );
);
// row of 12 pitch-class cells; returns clicked pc or -1
function pc_row(x, y, mask, clickable) local(k, cx, on, hov, res, blk) (
  res = -1; k = 0;
  loop(12,
    cx = x + k * 18.7;
    on = bitv(mask, k);
    blk = (k == 1 || k == 3 || k == 6 || k == 8 || k == 10);
    hov = clickable && hit(cx, y, 17, 20);
    on ? gfx_set(0.93, 0.62, 0.28, 1) : ( hov ? gfx_set(0.27, 0.30, 0.37, 1) : ( blk ? gfx_set(0.10, 0.11, 0.14, 1) : gfx_set(0.20, 0.22, 0.27, 1) ) );
    fr(cx, y, 17, 20);
    on ? gfx_set(0.08, 0.09, 0.11, 1) : gfx_set(0.62, 0.63, 0.66, 1);
    pcname(k, #pcl); ftc(cx, y, 17, 20, #pcl, 3);
    (clickable && hov && mclick) ? ( res = k; );
    k += 1;
  );
  res;
);

// ---------- scale library helpers ----------
function lib_cat_of(i) local(c, r) ( r = 0; c = 0; loop(9, (i >= M_CATS[c] && i < M_CATS[c] + M_CATN[c]) ? ( r = c; ); c += 1;); r; );
function flt_build() local(i, c, st, cnt, pos, cur) (
  flt_n = 0;
  strlen(#filter) == 0 ? (
    c = floor(sc_cat + 0.5); st = M_CATS[c]; cnt = M_CATN[c];
    i = 0; loop(cnt, A_FLT[i] = st + i; i += 1;); flt_n = cnt;
  ) : (
    sprintf(#pat, "*%s*", #filter);
    i = 0; loop(NLIB, lib_name(i, #tn); match(#pat, #tn) ? ( A_FLT[flt_n] = i; flt_n += 1; ); i += 1;);
  );
  // scroll so the current scale is visible
  cur = M_CATS[floor(sc_cat + 0.5)] + floor(sc_idx + 0.5);
  pos = -1; i = 0; loop(flt_n, A_FLT[i] == cur ? ( pos = i; ); i += 1;);
  lst_off = pos >= 0 ? max(0, min(pos - 4, flt_n - LST_VIS)) : 0;
  flt_dirty = 0;
);
function scale_title(dst) local(c, ix) (
  sc_src == 0 ? (
    c = floor(sc_cat + 0.5); ix = min(floor(sc_idx + 0.5), M_CATN[c] - 1);
    lib_name(M_CATS[c] + ix, dst);
  ) : sc_src == 1 ? ( sprintf(dst, "Euclidean (%d events)", gen_ev);
  ) : sc_src == 2 ? ( sprintf(dst, "Clough-Douthett (%d events)", gen_ev);
  ) : sc_src == 3 ? ( sprintf(dst, "Deep (%d events, x%d)", gen_ev, gen_mult);
  ) : ( strcpy(dst, "Custom scale"); );
);
function in_chord(n) local(i, r) ( r = 0; i = 0; loop(cm_n, A_CHM[i] == n ? ( r = 1; ); i += 1;); r; );
function key_color(n, black) local(pc, sc, ch) (
  pc = pmod(n, 12); sc = bitv(scale_pcm, pc); ch = in_chord(n);
  ch ? gfx_set(0.93, 0.62, 0.28, 1) :
  sc ? ( black ? gfx_set(0.25, 0.44, 0.58, 1) : gfx_set(0.73, 0.83, 0.90, 1) ) :
       ( black ? gfx_set(0.10, 0.11, 0.13, 1) : gfx_set(0.91, 0.89, 0.85, 1) );
);
function is_held(n) ( stk_find(n) >= 0; );
function draw_kbd(x0, y0, w, h) local(low, n, pc, wi, kw, kx, isb, bw, nn) (
  low = 60 + (floor(ch_oct + 0.5) - 5) * 12;
  nn = 49; kw = w / 29; bw = kw * 0.6;
  wi = 0; n = low;
  loop(nn,
    pc = pmod(n, 12);
    isb = (pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10);
    isb ? 0 : (
      kx = x0 + wi * kw;
      key_color(n, 0); fr(kx, y0, kw - 1, h);
      is_held(n) ? ( gfx_set(0.78, 0.30, 0.30, 1); fr(kx, y0 + h - 6, kw - 1, 6); );
      pc == 0 ? ( gfx_set(0.35, 0.35, 0.37, 1); note_name(n, #kn); ft(kx + 3, y0 + h - 17, #kn, 3); );
      wi += 1;
    );
    n += 1;
  );
  wi = 0; n = low;
  loop(nn,
    pc = pmod(n, 12);
    isb = (pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10);
    isb ? (
      kx = x0 + wi * kw - bw / 2;
      key_color(n, 1); fr(kx, y0, bw, h * 0.6);
      is_held(n) ? ( gfx_set(0.78, 0.30, 0.30, 1); fr(kx, y0 + h * 0.6 - 6, bw, 6); );
    ) : ( wi += 1; );
    n += 1;
  );
);

// =====================================================================
//  frame
// =====================================================================
LST_VIS = 11;
uis = min(gfx_w / DW, gfx_h / DH); uis < 0.3 ? ( uis = 0.3; );
ox = floor((gfx_w - DW * uis) / 2); oy = floor((gfx_h - DH * uis) / 2);
uis != last_S ? (
  gfx_setfont(1, "Arial", floor(12 * uis + 0.5));
  gfx_setfont(2, "Arial", floor(22 * uis + 0.5));
  gfx_setfont(3, "Arial", floor(10 * uis + 0.5));
  last_S = uis;
);
mx = (mouse_x - ox) / uis; my = (mouse_y - oy) / uis;
mdown = mouse_cap & 1; rdown = mouse_cap & 2;
mclick = mdown && !(last_cap & 1); rclick = rdown && !(last_cap & 2);
shiftk = mouse_cap & 8;
wheel = mouse_wheel; mouse_wheel = 0;
tf_seen = 0;
flt_init == 0 ? ( flt_init = 1; flt_dirty = 1; );

gfx_clear = 18 + 20 * 256 + 25 * 65536;
gfx_a = 1;

// ---------------- input bar ----------------
gfx_set(0.60, 0.62, 0.67, 1); ft(10, 10, "INPUT", 1);
opt(58, 6, 56, 22, "Root", S_INMODE, 0);
opt(116, 6, 56, 22, "Degree", S_INMODE, 1);
opt(174, 6, 56, 22, "Direct", S_INMODE, 2);
opt(232, 6, 56, 22, "Auto", S_INMODE, 3);
in_mode == 3 ? (
  opt(302, 6, 100, 22, "Interchange", S_SUB, 0);
  opt(404, 6, 84, 22, "Modulation", S_SUB, 1);
  gfx_set(0.60, 0.62, 0.67, 1); ft(502, 10, "dist from", 1);
  opt(562, 6, 62, 22, "Original", 34, 0);
  opt(626, 6, 56, 22, "Current", 34, 1);
  tog(696, 6, 84, 22, "Autoreset", 35);
  btn(784, 6, 64, 22, "Reset", 0, 1) ? ( act = 1; );
);
gfx_set(0.60, 0.62, 0.67, 1); ft(872, 10, "Out ch", 1);
stepper(912, 6, 90, 0, "", 36, 0, 16, 2, 0);

// ---------------- header ----------------
scale_title(#sc_title);
strcpy(#sc_pos, ""); i = 0;
loop(sc_n, sprintf(#tp, "%d ", A_SC[i]); strcat(#sc_pos, #tp); i += 1;);
strcpy(#cn, ""); i = 0;
loop(cm_n, note_name(A_CHM[i], #tn2); strcat(#cn, #tn2); strcat(#cn, "  "); i += 1;);
strcpy(#cp, ""); i = 0;
loop(ch_cnt, sprintf(#tp, "%d ", A_CH[i]); strcat(#cp, #tp); i += 1;);

gfx_set(0.45, 0.47, 0.52, 1); ft(10, 36, "SCALE", 3);
gfx_set(0.55, 0.78, 0.95, 1); strcpy(#hs, #sc_title); fit_head(#hs, 480, 2); ft(10, 48, #hs, 2);
gfx_set(0.60, 0.62, 0.67, 1); strcpy(#hp, #sc_pos); strcpy(#hp2, "positions: "); strcat(#hp2, #hp); fit_head(#hp2, 480, 1); ft(10, 76, #hp2, 1);
gfx_set(0.45, 0.47, 0.52, 1); ft(510, 36, "CHORD", 3);
gfx_set(0.93, 0.62, 0.28, 1); strcpy(#hc, #cn); cm_n == 0 ? strcpy(#hc, "-"); fit_head(#hc, 490, 2); ft(510, 48, #hc, 2);
gfx_set(0.60, 0.62, 0.67, 1); strcpy(#hq, "steps: "); strcat(#hq, #cp); fit_head(#hq, 490, 1); ft(510, 76, #hq, 1);
in_mode == 0 ? strcpy(#ml, "Root: each held key sets its own root and plays its chord in the key's octave (polyphonic)");
in_mode == 1 ? strcpy(#ml, "Degree: each held white key plays the chord of its degree (polyphonic, 0-127)");
in_mode == 2 ? strcpy(#ml, "Direct: polyphonic pass-through");
in_mode == 3 ? ( auto_sub == 0 ?
  sprintf(#ml, "Auto / Modal Interchange: live mode rotation %d (baseline %d)", tx_mode, auto_base_rot) :
  sprintf(#ml, "Auto / Modulation: transposition %d", auto_mod_t < 0 ? 0 : auto_mod_t); );
gfx_set(0.45, 0.47, 0.52, 1); ft(10, 94, #ml, 3);
gfx_set(0.60, 0.62, 0.67, 1); ft(690, 92, "Common notes", 1);
opt(776, 90, 62, 16, "Hold", 38, 0);
opt(840, 90, 74, 16, "Retrigger", 38, 1);

draw_kbd(10, 110, 990, 52);

// ---------------- panels ----------------
PY = 170; PH = 354; PW = 240;
section(10, PY, PW, PH, "1", "SCALE");
section(260, PY, PW, PH, "2", "SCALE TRANSFORM");
section(510, PY, PW, PH, "3", "CHORD");
section(760, PY, PW, PH, "4", "CHORD TRANSFORM");

// ----- 1 SCALE -----
x = 18; w = 224;
opt(x, 196, 43, 20, "Library", 1, 0);
opt(x + 45, 196, 43, 20, "Euclid", 1, 1);
opt(x + 90, 196, 43, 20, "C-D", 1, 2);
opt(x + 135, 196, 43, 20, "Deep", 1, 3);
opt(x + 180, 196, 44, 20, "Custom", 1, 4);
sc_src == 0 ? (
  // category selector
  btn(x, 222, 22, 20, "<", 0, 1) ? ( set_sl_ui(2, max(0, sc_cat - 1)); strlen(#filter) == 0 ? ( flt_dirty = 1; ); );
  btn(x + w - 22, 222, 22, 20, ">", 0, 1) ? ( set_sl_ui(2, min(8, sc_cat + 1)); strlen(#filter) == 0 ? ( flt_dirty = 1; ); );
  gfx_set(0.18, 0.20, 0.25, 1); fr(x + 24, 222, w - 48, 20);
  gfx_set(0.95, 0.94, 0.90, 1);
  strlen(#filter) == 0 ? ( c = floor(sc_cat + 0.5); strcpy(#cat_s, "Category"); ) : strcpy(#cat_s, "All categories");
  strlen(#filter) == 0 ? (
    c = floor(sc_cat + 0.5);
    c == 0 ? strcpy(#cat_s, "Major and minor"); c == 1 ? strcpy(#cat_s, "European"); c == 2 ? strcpy(#cat_s, "Asian");
    c == 3 ? strcpy(#cat_s, "Indian"); c == 4 ? strcpy(#cat_s, "Pentatonic"); c == 5 ? strcpy(#cat_s, "Modal");
    c == 6 ? strcpy(#cat_s, "Jazz"); c == 7 ? strcpy(#cat_s, "Symmetric"); c == 8 ? strcpy(#cat_s, "Misc");
  );
  ftc(x + 24, 222, w - 48, 20, #cat_s, 1);
  // search field
  strcpy(#tfshow, #filter); strlen(#filter) == 0 ? strcpy(#tfshow, "search...");
  tf_id == 4 ? strcpy(#tfshow, #filter);
  tf_run(4, x, 248, w - 22, 20, 1);
  tf_id == 4 ? ( strcmp(#filter, #tfbuf) != 0 ? ( strcpy(#filter, #tfbuf); flt_dirty = 1; ); );
  btn(x + w - 20, 248, 20, 20, "x", 0, 1) ? ( strcpy(#filter, ""); strcpy(#tfbuf, ""); flt_dirty = 1; tf_id == 4 ? ( tf_id = 0; ); );
  flt_dirty ? flt_build();
  // list
  ly = 274; lh = 17;
  lst_off = max(0, min(lst_off, max(0, flt_n - LST_VIS)));
  hit(x, ly, w, lh * LST_VIS) && wheel != 0 ? ( lst_off = max(0, min(flt_n - LST_VIS, lst_off - (wheel > 0 ? 3 : -3))); wheel = 0; );
  cur_lib = M_CATS[floor(sc_cat + 0.5)] + min(floor(sc_idx + 0.5), M_CATN[floor(sc_cat + 0.5)] - 1);
  gfx_set(0.07, 0.08, 0.10, 1); fr(x, ly, w, lh * LST_VIS);
  r = 0;
  loop(LST_VIS,
    k = lst_off + r;
    k < flt_n ? (
      gi = A_FLT[k];
      hv = hit(x, ly + r * lh, w - 9, lh);
      (sc_src == 0 && gi == cur_lib) ? ( gfx_set(0.93, 0.62, 0.28, 1); fr(x, ly + r * lh, w - 9, lh); gfx_set(0.08, 0.09, 0.11, 1); ) :
      ( hv ? ( gfx_set(0.20, 0.23, 0.29, 1); fr(x, ly + r * lh, w - 9, lh); ); gfx_set(0.85, 0.85, 0.82, 1); );
      lib_name(gi, #ln); fit_head(#ln, w - 18, 1); ft(x + 4, ly + r * lh + 2, #ln, 1);
      (hv && mclick) ? (
        cc = lib_cat_of(gi);
        set_sl_ui(2, cc); set_sl_ui(3, gi - M_CATS[cc]); set_sl_ui(1, 0);
      );
    );
    r += 1;
  );
  // scrollbar
  gfx_set(0.14, 0.16, 0.20, 1); fr(x + w - 7, ly, 7, lh * LST_VIS);
  flt_n > LST_VIS ? (
    sb_h = max(14, lh * LST_VIS * LST_VIS / flt_n);
    sb_y = ly + (lh * LST_VIS - sb_h) * lst_off / (flt_n - LST_VIS);
    gfx_set(0.45, 0.47, 0.52, 1); fr(x + w - 7, sb_y, 7, sb_h);
    (mclick && hit(x + w - 9, ly, 11, lh * LST_VIS)) ? ( act_id = 300; );
    act_id == 300 ? ( mdown ? ( lst_off = max(0, min(flt_n - LST_VIS, floor((my - ly - sb_h / 2) / (lh * LST_VIS - sb_h) * (flt_n - LST_VIS) + 0.5))); ) : ( act_id = 0; ); );
  );
  gfx_set(0.45, 0.47, 0.52, 1);
  sprintf(#cnt_s, "%d scales", flt_n); ft(x, ly + lh * LST_VIS + 3, #cnt_s, 3);
) : sc_src == 4 ? (
  gfx_set(0.60, 0.62, 0.67, 1); ft(x, 224, "Positions (integers, mod 12)", 1);
  list_str(1, #tfshow);
  tf_run(1, x, 242, w, 22, 0) ? (
    n = parse_list(#tfbuf, G_TMP, 0);
    i = 0; loop(n, A_SCP[i] = G_TMP[i]; i += 1;);
    list_set_len(1, n);
  );
  gfx_set(0.45, 0.47, 0.52, 1); ft(x, 270, "Type a list and press Enter, or use the", 3); ft(x, 282, "pitch-class cells below.", 3);
) : (
  sc_src == 3 ? ( stepper(x, 224, w, 100, "Events", 4, 1, 12, 0, 7); stepper(x, 250, w, 100, "Multiplicity", 5, 1, 23, 0, 7); ) :
                ( stepper(x, 224, w, 100, "Events", 4, 1, 12, 0, 7); );
  gfx_set(0.45, 0.47, 0.52, 1);
  sc_src == 1 ? ( ft(x, 258, "Euclidean rhythm spread over 12 steps", 3); ) :
  sc_src == 2 ? ( ft(x, 258, "Clough-Douthett maximally even set", 3); ) :
                ( ft(x, 284, "Deep rhythm: i * multiplicity mod 12", 3); );
);
// base pitch-class set (before transforms)
gfx_set(0.60, 0.62, 0.67, 1); ft(x, 484, "base scale", 3);
bm = src_mask();
sc_src == 4 ? (
  pk = pc_row(x, 498, bm, 1);
  pk >= 0 ? (
    bm = bm + (bitv(bm, pk) ? -(2^pk) : 2^pk);
    n = 0; i = 0; loop(12, bitv(bm, i) ? ( A_SCP[n] = i; n += 1; ); i += 1;);
    list_set_len(1, n);
  );
) : ( pc_row(x, 498, bm, 0); );

// ----- 2 SCALE TRANSFORM -----
x = 268; w = 224;
stepper(x, 196, w, 90, "Root", 6, 0, 11, 1, 0);
stepper(x, 222, w, 90, "Mode", 7, 0, 11, 0, 0);
stepper(x, 248, w, 90, "Degree", 8, -12, 12, 0, 0);
tog(x, 274, 70, 20, "Invert", 9);
stepper(x + 76, 274, w - 76, 40, "axis", 10, -12, 12, 0, 0);
tog(x, 300, 107, 20, "Mirror", 11);
tog(x + 117, 300, 107, 20, "Negative", 12);
gfx_set(0.60, 0.62, 0.67, 1); ft(x, 340, "resulting scale", 3);
pc_row(x, 354, scale_pcm, 0);
gfx_set(0.45, 0.47, 0.52, 1);
sprintf(#t2, "%d notes", sc_n); ft(x, 380, #t2, 3);
ft(x, 404, "Order of operations:", 3);
ft(x, 418, "root > mode > degree > invert >", 3);
ft(x, 430, "mirror > negative", 3);
ft(x, 454, "drag a value, scroll, click left/right", 3);
ft(x, 466, "of it to step, right-click to reset", 3);

// ----- 3 CHORD -----
x = 518; w = 224;
stepper(x, 196, w, 90, "Octave", 13, 0, 9, 0, 4);
gfx_set(0.60, 0.62, 0.67, 1); ft(x, 226, "Criterion", 1);
opt(x + 70, 222, 76, 20, "Position", 14, 0);
opt(x + 148, 222, 76, 20, "Interval", 14, 1);
cr_type == 0 ? (
  gfx_set(0.60, 0.62, 0.67, 1); ft(x, 248, "Degrees (integers >= 0)", 1);
  list_str(2, #tfshow);
  tf_run(2, x, 266, w, 22, 0) ? (
    n = parse_list(#tfbuf, G_TMP, 1);
    i = 0; loop(n, A_CRP[i] = G_TMP[i]; i += 1;);
    list_set_len(2, n);
  );
  chips(x, 294, 2, 0);
) : (
  gfx_set(0.60, 0.62, 0.67, 1); ft(x, 248, "Interval steps (any integers)", 1);
  list_str(3, #tfshow);
  tf_run(3, x, 266, w, 22, 0) ? (
    n = parse_list(#tfbuf, G_TMP, 0);
    i = 0; loop(n, A_CRI[i] = G_TMP[i]; i += 1;);
    list_set_len(3, n);
  );
  chips(x, 294, 3, -1000);
);
gfx_set(0.45, 0.47, 0.52, 1); ft(x, 364, "chips: click +1, right-click -1, shift-click delete", 3);
stepper(x, 382, w, 90, "Degree", 15, -72, 80, 0, 0);
stepper(x, 408, w, 90, "Rotation", 16, -12, 12, 0, 0);
stepper(x, 434, w, 90, "Voices (0=all)", 17, 0, 32, 0, 0);
gfx_set(0.45, 0.47, 0.52, 1); ft(x, 462, "max 64 entries per list", 3);

// ----- 4 CHORD TRANSFORM -----
x = 768; w = 224;
stepper(x, 196, w, 90, "Position", 18, -12, 12, 0, 0);
stepper(x, 222, w, 90, "Offset", 19, -24, 24, 0, 0);
stepper(x, 248, w, 90, "Mode", 20, 0, 11, 0, 0);
tog(x, 274, 70, 20, "Invert", 21);
stepper(x + 76, 274, w - 76, 40, "axis", 22, -12, 12, 0, 0);
tog(x, 300, 107, 20, "Mirror", 23);
tog(x + 117, 300, 107, 20, "Negative", 24);
tog(x, 326, 107, 20, "Close", 25);
tog(x + 117, 326, 107, 20, "Spread", 26);
tog(x + 117, 352, 107, 20, "top cluster", 27);
tog(x, 378, 70, 20, "Resize", 28);
